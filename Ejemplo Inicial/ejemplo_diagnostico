% --- Hechos ---
sintoma(gripe, fiebre).
sintoma(gripe, tos).
sintoma(gripe, dolor_cabeza).
sintoma(gripe, congestion).

sintoma(resfriado, tos).
sintoma(resfriado, estornudos).
sintoma(resfriado, congestion).

sintoma(migrana, dolor_cabeza).
sintoma(migrana, nauseas).
sintoma(migrana, sensibilidad_luz).

tratamiento(gripe, reposo).
tratamiento(gripe, liquidos).
tratamiento(gripe, paracetamol).

tratamiento(resfriado, reposo).
tratamiento(resfriado, liquidos).
tratamiento(resfriado, vitamina_c).

tratamiento(migrana, reposo).
tratamiento(migrana, analgesicos).
tratamiento(migrana, ambiente_silencioso).

% --- Motor de preguntas ---
preguntar(Sintoma) :-
    format("¿Tiene ~w? (si/no): ", [Sintoma]),
    read(Respuesta),
    (Respuesta == si -> assertz(paciente(Sintoma)) ; true).

recoger_sintomas :-
    forall(sintoma(_, S), preguntar(S)).

% --- Diagnóstico múltiple con explicación ---
diagnosticar_todos(Resultados) :-
    setof((Enfermedad, SintomasCoincidentes, Tratamientos),
        (
            sintoma(Enfermedad, _),  % fuerza a que Enfermedad sea un hecho existente
            findall(S, (sintoma(Enfermedad, S), paciente(S)), SintomasCoincidentes),
            SintomasCoincidentes \= [],
            findall(S, sintoma(Enfermedad, S), ListaEnfermedad),
            subset(ListaEnfermedad, SintomasCoincidentes),
            findall(T, tratamiento(Enfermedad, T), Tratamientos)
        ),
        Resultados), !.
diagnosticar_todos([]).

consultar :-
    diagnosticar_todos(Resultados),
    (Resultados \= [] ->
        mostrar_resultados(Resultados)
    ; format("No se encontró una enfermedad que coincida con los síntomas.~n", [])),
    limpiar_paciente.

mostrar_resultados([]).
mostrar_resultados([(Enfermedad, SintomasCoincidentes, Tratamientos)|Resto]) :-
    format("Diagnóstico posible: ~w~n", [Enfermedad]),
    format("Síntomas que coincidieron: ~w~n", [SintomasCoincidentes]),
    format("Tratamientos recomendados: ~w~n~n", [Tratamientos]),
    mostrar_resultados(Resto).

% --- Limpieza automática ---
limpiar_paciente :-
    retractall(paciente(_)).